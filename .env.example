# Copy to `.env.local` and adjust. Values here are documentation-only examples.

# =============================================================================
# Internationalization (keep in sync with i18n/routing.ts)
# =============================================================================
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es

# IANA tz database id for next-intl date/time formatting (default: America/Denver)
# NEXT_PUBLIC_TIME_ZONE=America/Denver

# Optional Convex chat behavior (see PROJECT_PLAN.md)
# ENABLE_CROSS_LOCALE_FALLBACK=false

CLERK_ADMIN_HOST=admin.localhost

CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=

NEXT_PUBLIC_CONVEX_SITE_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

CLERK_SECRET_KEY=

# Clerk UI + sessions only run on /[locale]/admin/** (and /__clerk/*) by default.
# In production, set this to your admin subdomain so the public site never loads Clerk:
# CLERK_ADMIN_HOST=admin.startup.utah.gov
# Local testing with a fake admin host (add to /etc/hosts: 127.0.0.1 admin.localhost):
# CLERK_ADMIN_HOST=admin.localhost
# Leave unset for path-only admin on any hostname (convenient for local dev).
CLERK_ADMIN_HOST=