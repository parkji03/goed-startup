# Copy to `.env.local` and adjust. Values here are documentation-only examples.

# =============================================================================
# Internationalization (keep in sync with i18n/routing.ts)
# =============================================================================
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es

# IANA tz database id for next-intl date/time formatting (default: America/Denver)
# NEXT_PUBLIC_TIME_ZONE=America/Denver

# Optional Convex chat behavior (see PROJECT_PLAN.md)
# ENABLE_CROSS_LOCALE_FALLBACK=false
